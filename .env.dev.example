DB_HOST=postgres  # For Docker keep 'postgres', otherwise keep localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=community_dev
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/community_dev?schema=public"

# --- mail (used by src/auth/email.service.ts) ---
# IMPORTANT: Gmail requires an "App Password" (16 chars, generated at
# https://myaccount.google.com/apppasswords) for SMTP. Your normal Gmail
# password will be rejected with "534-5.7.9 Application-specific password
# required". 2-Step Verification must be enabled on the account first.
EMAIL_USER="you@example.com"
EMAIL_PASS="your_16_char_app_password"
# Optional: set this to a deployed frontend URL instead of NGROK_DOMAIN/localhost
# RESET_LINK_BASE="https://myapp.example.com"

# --- ngrok tunneling ---
NGROK_ENABLED=true
NGROK_DOMAIN=your-ngrok-domain.ngrok-free.app
NGROK_AUTHTOKEN=your_ngrok_authtoken
PORT=3000
