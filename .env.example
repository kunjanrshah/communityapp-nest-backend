# ===== Application =====
NODE_ENV=prod
PORT=3000

# ===== Database =====
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me_in_prod
DB_NAME=community_prod
DATABASE_URL="postgresql://postgres:change_me_in_prod@postgres:5432/community_prod?schema=public"

# ===== Auth / JWT =====
# Generate a strong secret, e.g.: openssl rand -base64 32
JWT_SECRET="change_me_in_prod"

# ===== Email (Nodemailer / Gmail SMTP) =====
# Use a Gmail App Password (16 chars), not your regular Gmail password.
EMAIL_USER="you@example.com"
EMAIL_PASS="your_16_char_app_password"

# ===== Public base URL (used for password-reset links) =====
# Set this to your permanent prod domain, e.g. https://api.yourdomain.com
RESET_LINK_BASE="https://yourdomain.com/"

# ===== CORS / Frontend =====
# FRONTEND_URL="https://yourdomain.com"
