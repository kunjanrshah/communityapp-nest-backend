# ===== Application =====
NODE_ENV=prod
PORT=3000

# ===== Database =====
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me_in_prod
DB_NAME=community_prod
DATABASE_URL="postgresql://postgres:change_me_in_prod@postgres:5432/community_prod?schema=public"

# ===== Auth / JWT =====
# Generate a strong secret, e.g.: openssl rand -base64 32
JWT_SECRET="change_me_in_prod"

# ===== Email (Nodemailer / SMTP) =====
# Gmail free tier: ~500 emails/day. For production, use a dedicated SMTP service.
# Sender identity (used as the "From" address)
EMAIL_USER="you@example.com"
EMAIL_PASS="your-smtp-password-or-api-key"
EMAIL_NAME="Community App Support"
# --- Option A: Custom SMTP host (SendGrid, Brevo, Mailgun, Amazon SES, etc.) ---
# Set SMTP_HOST to use a dedicated provider. Leave empty to use EMAIL_SERVICE below.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false     # 'true' for port 465 (SSL), 'false' for 587 (STARTTLS)

# ===== Public base URL (used for password-reset links) =====
# Set this to your permanent prod domain, e.g. https://api.yourdomain.com
RESET_LINK_BASE="https://yourdomain.com/"

# ===== CORS / Frontend =====
# FRONTEND_URL="https://yourdomain.com"
